# Local Ollama server used for fact extraction (src/pipeline/extract.mts).
# Install: brew install ollama && brew services start ollama
# Pull the model once: ollama pull qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Transcript API stub (see api.md / api_stub_server.js)
TRANSCRIPT_API_BASE_URL=http://127.0.0.1:8000

# SQLite database file (WAL mode). Directory is created automatically if missing.
DB_PATH=./data/client_context.db
